# ============================================================
# Mingle Booth — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real credentials.
# Vite exposes variables prefixed with VITE_ to the browser.
# ============================================================

# ── Cloudinary (unsigned upload — no API secret needed) ──────
# Get these from: https://cloudinary.com/console

# Your Cloudinary cloud name (found in Dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# An UNSIGNED upload preset (Cloudinary → Settings → Upload → Upload presets)
# Create one: Mode = Unsigned, Folder = mingle-booth
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional: folder prefix inside your Cloudinary media library
VITE_CLOUDINARY_FOLDER=mingle-booth

# ── Supabase (session database) ──────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
#
# Steps:
#  1. Create a Supabase project
#  2. Run the SQL schema from the implementation plan in the SQL Editor
#  3. Copy the values below from Settings → API

# Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Public anon key (safe to expose — RLS is enabled on all tables)
VITE_SUPABASE_ANON_KEY=eyJhbGci...
